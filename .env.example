# FIRMSGeoTools clean install
# Copy this file to .env.local. NEVER commit real values.

INSTALL_PROFILE=core

# Supabase project reference (the subdomain before .supabase.co)
SUPABASE_PROJECT_REF=your-project-ref

# NASA FIRMS — required
# Get MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# Telegram — required for Core notifications
# Create a bot with @BotFather and add it to the destination channel/group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional but recommended: private Telegram admin panel.
# Use your private chat/user ID, not the public channel ID.
TELEGRAM_ADMIN_CHAT_ID=
# Generate a random secret. Telegram sends it in the webhook header.
TELEGRAM_ADMIN_WEBHOOK_SECRET=

# Protects the one-time firewatch-setup endpoint.
# Generate at least 32 random bytes / 64 hex characters.
INSTALL_TOKEN=

# Local files used by installer
AOI_FILE=config/aoi.geojson
REGIONS_FILE=
CONFIG_FILE=config/monitoring.json

# Optional Full-profile credentials (not used by Core yet)
LSASAF_USERNAME=
LSASAF_PASSWORD=
CDSE_USERNAME=
CDSE_PASSWORD=
OPENAQ_API_KEY=
