# FIRMSGeoTools clean install
# Copy this file to .env.local or another private file.
# NEVER commit real values.

# -------------------------------------------------------------------
# INSTALL PROFILE
# -------------------------------------------------------------------
INSTALL_PROFILE=core

# -------------------------------------------------------------------
# SUPABASE
# -------------------------------------------------------------------
# Used by local installer/CLI only.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Runtime SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided
# automatically to Supabase Edge Functions and should not be copied
# into public frontend code.

# -------------------------------------------------------------------
# NASA FIRMS — REQUIRED FOR CORE
# Get MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/
# -------------------------------------------------------------------
FIRMS_MAP_KEY=

# -------------------------------------------------------------------
# TELEGRAM — REQUIRED FOR NOTIFICATIONS
# Create bot with @BotFather.
# TELEGRAM_CHAT_ID is the destination channel/group ID.
# -------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional private admin chat/user ID.
TELEGRAM_ADMIN_CHAT_ID=

# -------------------------------------------------------------------
# APP-GENERATED SECRETS
# Generate random values during installation.
# -------------------------------------------------------------------
FIREWATCH_CRON_SECRET=
TELEGRAM_ADMIN_WEBHOOK_SECRET=

# -------------------------------------------------------------------
# OPTIONAL — EUMETSAT LSA SAF
# -------------------------------------------------------------------
LSASAF_USERNAME=
LSASAF_PASSWORD=

# -------------------------------------------------------------------
# OPTIONAL — COPERNICUS DATA SPACE / SENTINEL
# -------------------------------------------------------------------
CDSE_USERNAME=
CDSE_PASSWORD=

# -------------------------------------------------------------------
# OPTIONAL — OPENAQ
# -------------------------------------------------------------------
OPENAQ_API_KEY=
